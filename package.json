{
  "name": "ferchx-presskit",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "cd packages/web && bunx vite",
    "build": "turbo build",
    "build:web": "cd packages/web && bunx vite build",
    "start": "pm2 startOrRestart ecosystem.config.cjs --update-env",
    "stop": "pm2 delete web-app 2>/dev/null || true",
    "typecheck": "turbo typecheck",
    "lint": "cd packages/web && bunx oxlint src || true"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "oxfmt": "0.54.0",
    "oxlint": "0.16.0",
    "turbo": "2.9.18",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@libsql/client": "^0.17.2",
    "pm2": "^7.0.1"
  }
}
